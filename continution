MERGING ARRAYS:

merging means combining two arrays into one array
destination array is now dynamically sized using a variable length array(vla);

#include<stdio.h>
int main()
{
    int a[]={10,20,30};
    int b[]={40,50,60};
    int i,j,n1,n2,k;
    
    n1=sizeof(a)/sizeof(a[0]);
    n2=sizeof(b)/sizeof(b[0]);
    k=n1+n2;
    int c[k];
    
    for(i=0;i<n1;i++)
    {
        c[i]=a[i];    
    }
    
    for(i=0,j=0;j<n2;i++,j++)
    {
        c[n1+i]=b[j];
    }
     
    for(i=0;i<k;i++)
    {
        printf("%d ",c[i]);
    }

    return 0;
}
